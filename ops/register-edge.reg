Windows Registry Editor Version 5.00

; Register Estonian ID Card Personal Data Reader native host for Microsoft Edge
; Double-click this file to add the registry entry
; 
; NOTE: Update the path below to match your installation location!
; Default: C:\Program Files\eid-pd-reader\ee.aarepuusepp.eid_helper.json

[HKEY_CURRENT_USER\Software\Microsoft\Edge\NativeMessagingHosts\ee.aarepuusepp.eid_helper]
@="C:\\Program Files\\eid-pd-reader\\ee.aarepuusepp.eid_helper.json"

