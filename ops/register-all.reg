Windows Registry Editor Version 5.00

; Register Estonian ID Card Personal Data Reader native host for all browsers
; Double-click this file to add registry entries for Chrome, Edge, and Firefox
; 
; NOTE: Update the paths below to match your installation location!
; Default: C:\Program Files\eid-pd-reader\

; Google Chrome
[HKEY_LOCAL_MACHINE\Software\Google\Chrome\NativeMessagingHosts\ee.aarepuusepp.eid_pd_reader]
@="C:\\Program Files\\eid-pd-reader\\ee.aarepuusepp.eid_pd_reader.json"

; Microsoft Edge
[HKEY_LOCAL_MACHINE\Software\Microsoft\Edge\NativeMessagingHosts\ee.aarepuusepp.eid_pd_reader]
@="C:\\Program Files\\eid-pd-reader\\ee.aarepuusepp.eid_pd_reader.json"

; Mozilla Firefox
[HKEY_LOCAL_MACHINE\Software\Mozilla\NativeMessagingHosts\ee.aarepuusepp.eid_pd_reader]
@="C:\\Program Files\\eid-pd-reader\\ee.aarepuusepp.eid_pd_reader.firefox.json"

