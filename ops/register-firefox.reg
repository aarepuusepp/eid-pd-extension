Windows Registry Editor Version 5.00

; Register Estonian ID Card Personal Data Reader native host for Mozilla Firefox
; Double-click this file to add the registry entry
; 
; NOTE: Update the path below to match your installation location!
; Default: C:\Program Files\eid-pd-reader\ee.aarepuusepp.eid_helper.firefox.json
; 
; IMPORTANT: Firefox uses a separate manifest file (ee.aarepuusepp.eid_helper.firefox.json)
; because it requires "allowed_extensions" instead of "allowed_origins"

[HKEY_CURRENT_USER\Software\Mozilla\NativeMessagingHosts\ee.aarepuusepp.eid_helper]
@="C:\\Program Files\\eid-pd-reader\\ee.aarepuusepp.eid_helper.firefox.json"

