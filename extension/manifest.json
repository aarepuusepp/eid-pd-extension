{
  "manifest_version": 3,
  "name": "Estonian ID Card Personal Data Reader",
  "short_name": "EstEID PD",
  "version": "2.1.6",
  "description": "Reads personal data and decrypts CDOC containers with Estonian ID card via local native helper.",
  "author": "Aare Puusepp",
  "homepage_url": "https://github.com/aarepuusepp/web-eid-pd",
  "icons": {
    "16": "icons/icon16.png",
    "20": "icons/icon20.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "20": "icons/icon20.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Estonian ID Card Reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-api.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
