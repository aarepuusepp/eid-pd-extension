{
  "manifest_version": 3,
  "name": "Estonian ID Card Personal Data Reader",
  "short_name": "EstEID PD",
  "version": "1.0.3",
  "description": "Reads personal data directly from Estonian ID card chip when certificates are unavailable. Fallback for web-eid.js authentication.",
  "author": "Aare Puusepp",
  "homepage_url": "https://github.com/aarepuusepp/web-eid-pd",
  
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Estonian ID Card Reader"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["page-api.js"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  
  "host_permissions": [],
  
  "externally_connectable": {
    "matches": ["*://localhost/*", "http://localhost/*", "https://localhost/*"]
  }
}

