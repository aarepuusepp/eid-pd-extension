{
  "manifest_version": 3,
  "name": "Estonian ID Card Personal Data Reader",
  "short_name": "EstEID PD",
  "version": "2.1.2",
  "description": "Reads personal data and decrypts CDOC containers with Estonian ID card via local native helper.",
  "author": "Aare Puusepp",
  "homepage_url": "https://github.com/aarepuusepp/web-eid-pd",
  "developer": {
    "name": "Aare Puusepp",
    "url": "https://github.com/AarePuusepp"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "policy.js",
      "background-core.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Estonian ID Card Reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-api.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "eid-pd@aarepuusepp.ee",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
